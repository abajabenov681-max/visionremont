# Supabase project (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session JWT (any long random string, min 32 chars)
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-string-32+

# SMS OTP provider: Mobizon (mobizon.kz), REST API key.
# Leave empty to run in demo mode: every phone gets code 1234 without real SMS.
MOBIZON_API_KEY=

# Stage-demo phone: always gets code 1234 without SMS even when provider is on
DEMO_PHONE_NUMBER=+77000000000

# Fallback code used in demo mode
DEV_SMS_CODE=1234
