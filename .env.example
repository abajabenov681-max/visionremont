# Supabase project (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session JWT (any long random string, min 32 chars)
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-string-32+

# Dev auth: fixed SMS code accepted for any phone while SMS provider is not connected
DEV_SMS_CODE=1234
NEXT_PUBLIC_DEV_MODE=true
